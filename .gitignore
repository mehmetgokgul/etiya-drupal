# Ignore configuration files that may contain sensitive information
/web/sites/*/services*.yml

# Ignore paths that may contain user-generated content
/web/sites/*/files
/web/sites/*/private

# Ignore SimpleTest multi-site environment
/web/sites/simpletest

# Ignore core testing directories
/web/core/modules/*/tests/
/web/modules/*/tests/

# Ignore Drupal's file directory
/web/sites/default/files

# Ignore build artifacts
/build
/bin
/tmp
/node_modules
/bower_components
/vendor

# Ignore configuration files that may contain sensitive information
*.local.php
local.*.php
*.local.yml
local.*.yml

# Ignore Composer dependencies
/vendor/
/composer.phar

# Ignore DrupalVM
/.vagrant/

# Ignore .env files as they are personal
/.env
/.env.local

# Ignore IDE specific files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace

# OS specific files
.DS_Store
Thumbs.db
._*
.Spotlight-V100
.Trashes

# Ignore log files and databases
*.log
*.sql
*.sqlite

# Ignore generated files
/web/sites/*/translations
/web/sites/*/tmp
/web/sites/*/cache

# Ignore Drupal scaffold files
.editorconfig
.gitattributes
web.config

# Ignore other common development files
*.diff
*.bak
*.swp
*~

# Ignore directories generated by Composer
bin/
web/core/
web/modules/contrib/
web/themes/contrib/
web/profiles/contrib/
web/profiles/varbase/
web/libraries/

# Ignore paths that contain user-generated content.
web/files
web/sites/*/files
web/sites/*/private
web/sites/*/settings.local.php
web/*/settings.local.ph
acquia-file
/log

/.editorconfig
/.gitattributes

/.gz
/.sql
*.gz
*.sql

/.drush-lock-update
/autoload.php
